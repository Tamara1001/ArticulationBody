/* HUD de la estación — paleta: pizarra oscura + ámbar de seguridad + cian del target */
.root {
    flex-grow: 1;
    justify-content: space-between;
    padding: 14px;
    color: rgb(226, 232, 240);
    font-size: 14px;
}

.panel {
    background-color: rgba(16, 20, 27, 0.88);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    padding: 12px 14px;
}

.section-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(242, 183, 5);
    margin-bottom: 8px;
}

/* ---------- barra superior ---------- */
.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
}
.brand { flex-direction: row; align-items: center; }
.brand-mark {
    width: 30px; height: 30px; border-radius: 6px; margin-right: 10px;
    background-color: rgb(242, 183, 5);
    -unity-text-align: middle-center; color: rgb(16, 20, 27); -unity-font-style: bold; font-size: 16px;
}
.title { font-size: 17px; -unity-font-style: bold; color: rgb(245, 247, 250); }
.subtitle { font-size: 11px; color: rgb(140, 152, 168); }
.chips { flex-direction: row; align-items: center; }
.chip {
    padding: 3px 10px; margin: 0 4px; border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06); font-size: 12px; color: rgb(190, 200, 214);
}
.chip--ok { background-color: rgba(76, 217, 123, 0.16); color: rgb(120, 230, 160); }
.chip--warn { background-color: rgba(255, 93, 93, 0.22); color: rgb(255, 140, 140); }
.actions { flex-direction: row; }

.btn {
    margin: 0 3px; padding: 5px 12px; border-radius: 7px; border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(226, 232, 240); font-size: 13px;
    transition-duration: 0.12s;
}
.btn:hover { background-color: rgba(255, 255, 255, 0.14); }
.btn:active { background-color: rgba(242, 183, 5, 0.35); }
.btn--primary { background-color: rgb(242, 183, 5); color: rgb(20, 22, 26); -unity-font-style: bold; border-width: 0; }
.btn--primary:hover { background-color: rgb(255, 204, 51); }
.btn--danger { border-color: rgba(255, 93, 93, 0.5); }
.btn--on { background-color: rgba(255, 93, 93, 0.35); border-color: rgb(255, 93, 93); }
.btn--small { padding: 3px 8px; font-size: 12px; margin: 0 2px; flex-grow: 1; }
.btn--active { background-color: rgba(64, 217, 255, 0.22); border-color: rgba(64, 217, 255, 0.7); }

/* ---------- cuerpo ---------- */
.body { flex-grow: 1; flex-direction: row; justify-content: space-between; margin-top: 12px; margin-bottom: 12px; }
.side { width: 360px; }
.side > .panel { margin-bottom: 10px; }

/* ---------- tarjetas de joint ---------- */
.joint { padding: 10px 0; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.06); }
.joint--last { border-bottom-width: 0; }
.joint-head { flex-direction: row; align-items: center; justify-content: space-between; }
.joint-name { font-size: 14px; -unity-font-style: bold; color: rgb(240, 244, 248); }
.joint-type { font-size: 11px; color: rgb(130, 142, 158); margin-left: 6px; }
.joint-meta { flex-direction: row; align-items: center; }
.key {
    padding: 1px 6px; border-radius: 4px; margin-left: 4px; font-size: 11px;
    background-color: rgba(255, 255, 255, 0.09); color: rgb(200, 210, 222);
    border-bottom-width: 2px; border-color: rgba(0, 0, 0, 0.35);
}
.lock { font-size: 11px; color: rgb(255, 140, 140); margin-left: 6px; display: none; }
.lock--on { display: flex; }
.sat { font-size: 11px; color: rgb(255, 170, 60); margin-left: 6px; display: none; }
.sat--on { display: flex; }

.values { flex-direction: row; justify-content: space-between; margin-top: 6px; }
.value-block { flex-direction: row; align-items: flex-end; }
.value-label { font-size: 11px; color: rgb(130, 142, 158); margin-right: 5px; margin-bottom: 1px; }
.value-target { font-size: 16px; -unity-font-style: bold; color: rgb(64, 217, 255); }
.value-real { font-size: 16px; -unity-font-style: bold; color: rgb(242, 183, 5); }

.bar { height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.07); margin-top: 6px; }
.bar-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background-color: rgba(242, 183, 5, 0.85); }
.bar-target { position: absolute; top: -3px; bottom: -3px; width: 3px; margin-left: -1px; background-color: rgb(64, 217, 255); border-radius: 1px; }

.joint-slider { margin: 6px 0 2px 0; }
.joint-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.10); border-width: 0; height: 4px; margin-top: -2px; border-radius: 2px;
}
.joint-slider .unity-base-slider__dragger {
    width: 14px; height: 14px; margin-top: -7px; border-radius: 7px;
    background-color: rgb(226, 232, 240); border-width: 2px; border-color: rgb(64, 217, 255);
}
.presets { flex-direction: row; margin-top: 4px; }

/* ---------- sensores ---------- */
.sensor { flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 0; }
.sensor-name { font-size: 13px; color: rgb(200, 210, 222); }
.sensor-sub { font-size: 11px; color: rgb(130, 142, 158); }
.sensor-value { font-size: 22px; -unity-font-style: bold; color: rgb(245, 247, 250); -unity-text-align: middle-right; }
.sensor-value--live { color: rgb(120, 230, 160); }
.sensor-value--dim { color: rgb(110, 120, 134); }

.rule { flex-direction: row; justify-content: space-between; padding: 3px 0; font-size: 13px; }
.rule-k { color: rgb(160, 172, 188); }
.rule-v { color: rgb(240, 244, 248); -unity-font-style: bold; }

.stats { flex-direction: row; justify-content: space-between; }
.stat { align-items: center; flex-grow: 1; }
.stat-n { font-size: 24px; -unity-font-style: bold; }
.stat-l { font-size: 11px; color: rgb(130, 142, 158); }
.stat--ok { color: rgb(120, 230, 160); }
.stat--bad { color: rgb(255, 140, 140); }
.stat--warn { color: rgb(255, 190, 90); }

/* ---------- parte inferior ---------- */
.bottom { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.guide { flex-direction: row; align-items: center; max-width: 900px; }
.guide-step {
    width: 34px; height: 34px; border-radius: 17px; margin-right: 12px;
    background-color: rgb(242, 183, 5); color: rgb(16, 20, 27);
    -unity-text-align: middle-center; -unity-font-style: bold; font-size: 16px;
}
.guide-text { font-size: 15px; color: rgb(240, 244, 248); white-space: normal; max-width: 820px; }
.toasts { align-items: flex-end; width: 520px; }
.toast {
    padding: 7px 12px; border-radius: 8px; margin-top: 6px; font-size: 13px;
    background-color: rgba(16, 20, 27, 0.92); border-left-width: 4px; border-color: rgb(140, 152, 168);
    white-space: normal; transition-property: opacity; transition-duration: 0.4s;
}
.toast--ok { border-color: rgb(76, 217, 123); }
.toast--bad { border-color: rgb(255, 93, 93); }
.toast--warn { border-color: rgb(255, 170, 60); }

/* ---------- banner de prueba en seco ---------- */
.dry-banner {
    position: absolute; top: 74px; left: 50%; translate: -50% 0;
    padding: 6px 18px; border-radius: 8px; background-color: rgba(255, 93, 93, 0.9);
    color: rgb(255, 255, 255); -unity-font-style: bold; display: none;
}
.dry-banner--on { display: flex; }

/* ---------- ayuda ---------- */
.overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(6, 8, 12, 0.72); align-items: center; justify-content: center; display: none;
}
.overlay--on { display: flex; }
.help { width: 860px; padding: 22px 26px; }
.help-title { font-size: 22px; -unity-font-style: bold; color: rgb(245, 247, 250); margin-bottom: 4px; }
.help-intro { font-size: 14px; color: rgb(190, 200, 214); white-space: normal; margin-bottom: 14px; }
.help-cols { flex-direction: row; justify-content: space-between; }
.help-col { width: 48%; }
.help-row { flex-direction: row; justify-content: space-between; padding: 3px 0; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.help-k { color: rgb(242, 183, 5); -unity-font-style: bold; font-size: 13px; }
.help-v { color: rgb(220, 228, 236); font-size: 13px; }
.help-steps { margin-top: 12px; font-size: 13px; color: rgb(220, 228, 236); white-space: normal; }
.help-footer { flex-direction: row; justify-content: flex-end; margin-top: 16px; }
